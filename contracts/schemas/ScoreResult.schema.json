{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hireguard.local/contracts/ScoreResult.schema.json",
  "title": "ScoreResult",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "role_id": {
      "type": "string"
    },
    "rubric_version": {
      "type": "string"
    },
    "criterion_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "points": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "criterion_id",
          "points"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "score_total": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "pass": {
      "type": "boolean"
    },
    "evaluated_transcript_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "session_id",
    "role_id",
    "rubric_version",
    "criterion_scores",
    "score_total",
    "pass",
    "evaluated_transcript_hash"
  ],
  "additionalProperties": false,
  "description": "Target-side scoring result; separate from SendTurn reply. Pass threshold must follow frozen RoleConfig."
}
