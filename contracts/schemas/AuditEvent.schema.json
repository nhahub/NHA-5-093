{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hireguard.local/contracts/AuditEvent.schema.json",
  "title": "AuditEvent",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt_[a-f0-9]{12}$"
    },
    "run_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "STATE",
        "DECISION",
        "TURN",
        "CHECK",
        "ERROR"
      ]
    },
    "actor": {
      "type": "string",
      "enum": [
        "CONTROLLER",
        "AGENT",
        "TARGET",
        "CHECKER"
      ]
    },
    "turn_index": {
      "type": "integer",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    }
  },
  "required": [
    "event_id",
    "run_id",
    "seq",
    "event_type",
    "actor",
    "turn_index",
    "occurred_at",
    "data"
  ],
  "additionalProperties": false,
  "description": "Append-only event envelope with enforced type-specific payload; never mutate events.",
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "STATE"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "old_status": {
                "oneOf": [
                  {
                    "type": "string",
                    "enum": [
                      "QUEUED",
                      "RUNNING",
                      "COMPLETED",
                      "FAILED",
                      "CANCELLED"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "new_status": {
                "type": "string",
                "enum": [
                  "QUEUED",
                  "RUNNING",
                  "COMPLETED",
                  "FAILED",
                  "CANCELLED"
                ]
              },
              "cause": {
                "type": "string"
              }
            },
            "required": [
              "old_status",
              "new_status",
              "cause"
            ],
            "additionalProperties": false
          },
          "actor": {
            "const": "CONTROLLER"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "DECISION"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "observed_fact": {
                "type": "string"
              },
              "strategy_id": {
                "type": "string"
              },
              "decision_reason": {
                "type": "string"
              },
              "usage": {
                "type": "object",
                "properties": {
                  "input_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "output_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total_tokens": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "input_tokens",
                  "output_tokens",
                  "total_tokens"
                ],
                "additionalProperties": false,
                "description": "Reported usage, total = input+output"
              }
            },
            "required": [
              "observed_fact",
              "strategy_id",
              "decision_reason",
              "usage"
            ],
            "additionalProperties": false
          },
          "actor": {
            "const": "AGENT"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "TURN"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "candidate_message": {
                "type": "string"
              },
              "target_response": {
                "type": "string"
              },
              "model_id": {
                "type": "string"
              },
              "usage": {
                "type": "object",
                "properties": {
                  "input_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "output_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total_tokens": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "input_tokens",
                  "output_tokens",
                  "total_tokens"
                ],
                "additionalProperties": false,
                "description": "Reported usage, total = input+output"
              },
              "latency_ms": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "candidate_message",
              "target_response",
              "model_id",
              "usage",
              "latency_ms"
            ],
            "additionalProperties": false
          },
          "actor": {
            "const": "TARGET"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "CHECK"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "check_id": {
                "type": "string"
              },
              "rule_id": {
                "type": "string"
              },
              "result": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "INCONCLUSIVE"
                ]
              },
              "evidence_event_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 0
              },
              "evidence_spans": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 0
              },
              "checker_version": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "check_id",
              "rule_id",
              "result",
              "evidence_event_ids",
              "evidence_spans",
              "checker_version",
              "reason"
            ],
            "additionalProperties": false
          },
          "actor": {
            "const": "CHECKER"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "ERROR"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          },
          "actor": {
            "const": "CONTROLLER"
          }
        }
      }
    }
  ]
}
