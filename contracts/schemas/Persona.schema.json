{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hireguard.local/contracts/Persona.schema.json",
  "title": "Persona",
  "type": "object",
  "properties": {
    "persona_ref": {
      "type": "string",
      "pattern": "^persona_[a-z0-9_-]+$"
    },
    "display_name": {
      "type": "string"
    },
    "background": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "MSA",
        "EGY"
      ]
    },
    "is_synthetic": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "persona_ref",
    "display_name",
    "background",
    "language",
    "is_synthetic"
  ],
  "additionalProperties": false
}
