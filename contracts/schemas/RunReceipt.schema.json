{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hireguard.local/contracts/RunReceipt.schema.json",
  "title": "RunReceipt",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^run_[a-f0-9]{12}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "QUEUED",
        "RUNNING",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "run_id",
    "status",
    "config_hash"
  ],
  "additionalProperties": false
}
