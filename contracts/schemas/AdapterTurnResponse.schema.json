{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hireguard.local/contracts/AdapterTurnResponse.schema.json",
  "title": "AdapterTurnResponse",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "turn_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "reply_text": {
      "type": "string"
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "additionalProperties": false,
      "description": "Reported usage, total = input+output"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "model_id": {
      "type": "string"
    },
    "provider_request_id": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "session_id",
    "turn_index",
    "reply_text",
    "usage",
    "latency_ms",
    "model_id",
    "provider_request_id"
  ],
  "additionalProperties": false
}
