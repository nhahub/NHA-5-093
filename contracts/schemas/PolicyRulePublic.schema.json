{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hireguard.local/contracts/PolicyRulePublic.schema.json",
  "title": "PolicyRulePublic",
  "type": "object",
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^POL-[A-Z]+-[0-9]{2}-[A-Z0-9-]+$"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "review_required": {
      "type": "boolean"
    }
  },
  "required": [
    "rule_id",
    "version",
    "description",
    "severity",
    "review_required"
  ],
  "additionalProperties": false,
  "description": "Sanitized result of load_policy; DOES NOT include forbidden_value or checker internals."
}
