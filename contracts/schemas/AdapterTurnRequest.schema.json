{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hireguard.local/contracts/AdapterTurnRequest.schema.json",
  "title": "AdapterTurnRequest",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "turn_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "run_id",
    "session_id",
    "turn_index",
    "message",
    "idempotency_key"
  ],
  "additionalProperties": false
}
