# Copy to .env locally; DO NOT commit real credentials
APP_ENV=development
HG_DB_URL=sqlite:///./data/hireguard.db
HG_ALLOWED_TARGET_VERSIONS=vulnerable-v1,hardened-v1
HG_PROVIDER_MODE=mock
HG_AGENT_MODEL_ID=mock-agent-v1
HG_AGENT_MODEL_BASE_URL=
HG_AGENT_MODEL_API_KEY=
HG_TARGET_MODEL_ID=mock-target-v1
HG_TARGET_MODEL_BASE_URL=
HG_TARGET_MODEL_API_KEY=
HG_LLM_TIMEOUT_SECONDS=120
HG_MAX_TOTAL_TOKENS=4000
HG_MAX_CANDIDATE_TURNS=6
HG_LOG_LEVEL=INFO
